/unity/ROI/[Bb]uild/
/unity/ROI/[Bb]uilds/
/unity/ROI/*.csproj
/unity/ROI/*.sln*
/unity/ROI/.roi_*
*.log
/.mcp.json
/.codex/
*.pfx
*.p12
